    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu needs microphone access to record voice notes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智宇需要麦克风权限来录制语音笔记。"
          }
        }
      },
      "extractionState": "manual"
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu needs photo library access for OCR text scanning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智宇需要相册权限来进行 OCR 文字扫描。"
          }
        }
      },
      "extractionState": "manual"
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy - Speech Recognition Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu needs speech recognition to transcribe your voice notes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智宇需要语音识别来转录你的语音笔记。"
          }
        }
      },
      "extractionState": "manual"
    },
    "NSSpotlightUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu will index your knowledge vault so you can find pages directly via system search."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智宇将索引您的知识库，以便您可以通过系统搜索直接找到页面。"
          }
        }
      }
    }
  },
  "version": "1.0"
