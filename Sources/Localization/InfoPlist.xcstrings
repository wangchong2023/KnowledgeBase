    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu needs camera access to scan document text (OCR)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智宇需要相机权限来扫描文档文字（OCR）。"
          }
        }
      },
      "extractionState": "manual"
    },
    "NSHumanReadableCopyright": {
      "comment": "Copyright (human-readable)",
