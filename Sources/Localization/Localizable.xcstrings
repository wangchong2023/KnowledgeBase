    },
    "welcome.desc2" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发现知识间的隐秘联系。" } }
