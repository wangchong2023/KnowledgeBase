    "prompt.default.mindmap" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please generate a Mermaid mindmap. Requirements:\n1. Start with the `mindmap` keyword.\n2. Root node format: `root((Title))`.\n3. Do NOT include parentheses `()` or colons `:` in node labels. Use quotes for special characters, e.g., `\"Text (Bracket)\"`.\n4. Use 2-space indentation for levels. Do NOT use `-` or `*` prefixes.\n5. Output ONLY the code block."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请生成 Mermaid 思维导图。要求：\n1. 以 `mindmap` 开头。\n2. 根节点用 `root((标题))`。\n3. 节点文字禁止包含任何括号 `()` 或冒号 `:`，特殊字符须用引号包裹，如 `\"文字(括号)\"`。\n4. 使用缩进表示层级，禁止使用 `-` 开头。\n5. 仅输出代码块。"
          }
        }
      }
    },
    "prompt.default.quiz" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generate a quiz with 3 MCQs about the content. Output in JSON format: {\"title\":\"...\",\"questions\":[{\"id\":0,\"text\":\"...\",\"options\":[\"A\",\"B\",\"C\",\"D\"],\"answer\":0,\"explanation\":\"...\"}]}. answer is 0-based (0=A,1=B,2=C,3=D)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于内容生成知识测验，输出JSON格式：{\"title\":\"标题\",\"questions\":[{\"id\":0,\"text\":\"问题\",\"options\":[\"选项A\",\"选项B\",\"选项C\",\"选项D\"],\"answer\":0,\"explanation\":\"解释\"}]}。answer为0起始索引（0=A,1=B,2=C,3=D）。3道选择题。"
          }
        }
      }
    },
    "prompt.default.report" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请基于以下内容生成一份深度的分析报告。包含：核心摘要、现状分析、挑战与对策、结论建议。"
          }
        }
      }
    },
    "prompt.default.slides" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Role: Professional Presentation Coach\n# Task: Transform content into a presentation outline with citations.\n# Requirements:\n1. Use Markdown separator `---` for page breaks.\n2. Each page contains a title and 3-5 key points.\n3. **MUST include citations**: Mark each point with `[[Source]]`."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Role: 专业演讲教练\n# Task: 将内容转化为带引用的演示文稿大纲（幻灯片格式）。\n# Requirements:\n1. 使用 Markdown 分隔符 `---` 表示换页。\n2. 每页包含标题和 3-5 个核心要点。\n3. **必须标注来源**：每个要点后使用 `[[Source]]` 标记。"
          }
        }
      }
    },
